# Heretek Swarm API — Docker test build
FROM python:3.15-rc-alpine3.22

WORKDIR /app

# Install system dependencies for building psycopg2 and other packages if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    python3-dev \
    libc-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests and source code
COPY pyproject.toml uv.lock ./
COPY backend ./backend
COPY tests ./tests

# Install uv and all dependencies (including dev/testing packages)
RUN pip install --no-cache-dir uv && \
    uv sync --frozen --all-extras --no-editable && \
    uv pip install prometheus-client>=0.19.0 psycopg2-binary>=2.9.0 asyncpg>=0.29.0

# Set up environment path to use the virtualenv binaries (including pytest)
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Run the Phase C test suite by default
CMD ["pytest", "tests/test_s07_phase_c.py", "-v"]
