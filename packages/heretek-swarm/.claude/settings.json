{
  "env": {
    "ORCHESTKIT_COMMIT_SCOPE": "required",
    "ORCHESTKIT_AGENT_BROWSER_ALLOW_LOCALHOST": "1",
    "ORCHESTKIT_PERF_SNAPSHOT_ENABLED": "1",
    "ORCHESTKIT_LOG_LEVEL": "warn"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-sync-file-io.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-dont-gates.sh\""
          }
        ]
      }
    ]
  }
}
