# Heretek Swarm Environment Configuration Example
# Copy this file to .env and fill in your actual values
#
# Docker Compose: `docker compose up` starts ALL 6 services:
#   postgres, redis, qdrant, nats, api, dashboard
#
# No --profile flags needed — all services start by default.

# =============================================================================
# API Configuration
# =============================================================================
HERETEK_API_KEY=htsk_your_api_key_here

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# CORS Configuration (Production)
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true

# =============================================================================
# Database Configuration
# =============================================================================
# Docker Compose (default — `docker compose up` uses the service name):
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/heretek_swarm
# Local dev (no Docker): use localhost instead
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/heretek_swarm
POSTGRES_PASSWORD=password

# =============================================================================
# Redis Configuration
# =============================================================================
# Docker Compose (default):
REDIS_URL=redis://redis:6379
# Local dev (no Docker): REDIS_URL=redis://localhost:6379

# =============================================================================
# Qdrant Configuration (Vector Database)
# =============================================================================
# Docker Compose (default):
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
# Local dev (no Docker): QDRANT_HOST=localhost  QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# =============================================================================
# NATS Configuration
# =============================================================================
# Docker Compose (default):
HERETEK_NATS_URL=nats://nats:4222
# Local dev (no Docker): HERETEK_NATS_URL=nats://localhost:4222

# Heretek mTLS for NATS connections (requires secrets/certs.yaml to exist
# and contain valid CA + agent certificates).
# When enabled, NATS connects via tls:// with client certificate authentication.
HERETEK_MTLS_ENABLED=false

# =============================================================================
# OpenAI Compatible LLM Configuration
# =============================================================================
# Supports any OpenAI-compatible API (MiniMax, Together, Fireworks, etc.)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.minimax.io/v1
# A bare model name is routed through litellm's OpenAI-compatible provider
# automatically (it is prefixed with "openai/"). You may also set an explicit
# provider prefix yourself, e.g. "openai/MiniMax-M2.7" or "anthropic/claude-3".
LLM_MODEL=MiniMax-M2.7

# =============================================================================
# Embedding Provider (Lemonade Server / OpenAI Compatible)
# =============================================================================
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://127.0.0.1:13305/api/v1
EMBEDDING_API_KEY=lemonade
EMBEDDER_MODEL=nomic-embed-text-v2-moe-GGUF
EMBEDDING_DIMENSIONS=768

# =============================================================================
# Logging Configuration
# =============================================================================
HERETEK_LOG_LEVEL=INFO

# =============================================================================
# Agent Configuration
# =============================================================================
MAX_MAILBOX_SIZE=1000
HEARTBEAT_INTERVAL=10.0
PHASE_TIMEOUT=60.0

# =============================================================================
# Consensus Configuration
# =============================================================================
CONSENSUS_AHEAD_BY_K=2
CONSENSUS_MIN_VOTES=3
CONSENSUS_CONFIDENCE_THRESHOLD=0.6

# =============================================================================
# Memory Configuration
# =============================================================================
MEMORY_MAX_SIZE=10000
MEMORY_DEFAULT_TTL=3600

# =============================================================================
# Mem0 Self-Hosted Configuration
# =============================================================================
# PostgreSQL password for Mem0 metadata storage
MEM0_POSTGRES_PASSWORD=mem0-secret-change-me

# Mem0 LLM provider: "openai" for OpenAI-compatible API (any endpoint supporting OpenAI format)
# Options: "ollama" (local), "openai" (OpenAI/API compatible)
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=${LLM_MODEL}
MEM0_LLM_BASE_URL=${OPENAI_BASE_URL}
# Reuse the LLM API key from the main OpenAI-compatible config
MEM0_LLM_API_KEY=${OPENAI_API_KEY}

# Use LlamaParser for document parsing (optional, requires service running)
# MEM0_USE_LLAMAPARSER=true
# LLAMAPARSER_URL=http://localhost:2045

# =============================================================================
# Authentication & Security
# =============================================================================
JWT_SECRET=your_jwt_secret_here
API_KEY=your_api_key_here

# =============================================================================
# Anthropic Configuration (Optional)
# =============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# SOPS Secrets Management
# =============================================================================
# Heretek Swarm uses Mozilla SOPS with age encryption for secrets at rest.
# Encrypted secrets live in secrets/*.yaml and secrets/*.env (safe to commit).
#
# --- Age Key Generation ---
#   age-keygen -o key.txt
#   This produces a public key (age1...) and a secret key (AGE-SECRET-KEY-...).
#   Add your public key to .sops.yaml under `age:` recipients.
#
# --- Encrypting Secrets ---
#   sops --encrypt secrets/encrypted.env > secrets/encrypted.env.enc
#   Or edit in-place: sops secrets/encrypted.env  (opens $EDITOR)
#
# --- Decrypting Secrets ---
#   sops --decrypt secrets/encrypted.env
#   Requires SOPS_AGE_KEY set to your private key:
#     export SOPS_AGE_KEY="AGE-SECRET-KEY-..."
#
# --- CI / Production ---
#   Set SOPS_AGE_KEY in your CI/CD secret store.  Startup checks for this
#   variable; if absent in production, the process exits with an error.
#   In development, the fallback reads plain .env directly.
# =============================================================================

# =============================================================================
