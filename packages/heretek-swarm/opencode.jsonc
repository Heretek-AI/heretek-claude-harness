{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-chrome-devtools"
  ],
  "default_agent": "openwork",
  "provider": {},
  "mcp": {
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp",
      "oauth": {
        "redirectUri": "http://127.0.0.1:39699/mcp/oauth/callback?server=context7&directory=%2Fhome%2Fjohn%2FDesktop%2Fheretek-swarm"
      }
    },
    "openwork-ui": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "openwork-ui-mcp"
      ],
      "environment": {
        "OPENWORK_UI_CONTROL_DISCOVERY": "/home/john/.config/com.differentai.openwork/openwork-ui-control.json"
      }
    }
  },
  "disabled_providers": []
}
