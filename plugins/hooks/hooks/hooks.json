{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/fast_gate.py",
						"timeout": 1
					},
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/secrets_pre_tool.py",
						"timeout": 200
					}
				]
			},
			{
				"matcher": "Edit|Write|MultiEdit|Read|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/telemetry_collector.py",
						"async": true,
						"timeout": 200
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit|Read|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/post_tool_dispatcher.py",
						"async": true,
						"timeout": 2000
					}
				]
			}
		]
	}
}
