{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"]
    },
    "codebase-memory-mcp": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": []
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": ["serena-mcp"]
    },
    "context7-http": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
