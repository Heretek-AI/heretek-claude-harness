{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/fast-gate.sh",
						"timeout": 1
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh",
						"async": true,
						"timeout": 5
					}
				]
			}
		],
		"Notification": [
			{
				"matcher": "",
				"hooks": [{ "type": "command", "command": "echo notified" }]
			}
		]
	}
}
